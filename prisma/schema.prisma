generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["public"]
}

/////////////////////////////////////////////////
// ENUMS
/////////////////////////////////////////////////

enum UserRole {
  admin
  manager
  cashier

  @@map("user_role")
  @@schema("public")
}

enum UserStatus {
  pending
  active
  disabled

  @@map("user_status")
  @@schema("public")
}

enum TerminalRequestStatus {
  pending
  approved
  fulfilled
  rejected
  cancelled

  @@map("terminal_request_status")
  @@schema("public")
}

enum SubscriptionBillingCycle {
  monthly
  quarterly
  annually

  @@map("subscription_billing_cycle")
  @@schema("public")
}

enum SubscriptionStatus {
  pending
  active
  expired
  suspended
  cancelled

  @@map("subscription_status")
  @@schema("public")
}

enum RegistrationRequestStatus {
  pending
  approved
  rejected

  @@map("registration_request_status")
  @@schema("public")
}

enum PrinterConnectionType {
  usb
  bluetooth
  serial
  built_in

  @@map("printer_connection_type")
  @@schema("public")
}

enum PrinterTransport {
  usb
  bluetooth
  built_in

  @@map("printer_transport")
  @@schema("public")
}

enum PrinterDriver {
  webusb
  webbluetooth
  webserial
  sunmi_native

  @@map("printer_driver")
  @@schema("public")
}

enum DiscountCapType {
  percent
  amount

  @@map("discount_cap_type")
  @@schema("public")
}

/////////////////////////////////////////////////
// PROFILE (Single User Source)
/////////////////////////////////////////////////

model Profile {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @unique @map("user_id") @db.Uuid
  email  String @unique

  fullName String? @map("full_name")

  role   UserRole   @default(manager)
  status UserStatus @default(pending)

  pin String? @db.VarChar(6)

  approvedAt DateTime? @map("approved_at") @db.Timestamptz

  //////////////////////////////////////////////////
  // RELATIONS
  //////////////////////////////////////////////////

  companyId String?  @map("company_id") @db.Uuid
  company   Company? @relation(fields: [companyId], references: [id])

  timestampsAsCashier     Timestamp[] @relation("CashierTimestamp")
  timestampsAsManagerIn   Timestamp[] @relation("ManagerInTimestamp")
  timestampsAsManagerOut  Timestamp[] @relation("ManagerOutTimestamp")
  timestampsAsForceClosed Timestamp[] @relation("ForceClosedByTimestamp")

  invoicesAsCashier  Invoice[] @relation("CashierInvoice")
  invoicesAsVoidedBy Invoice[] @relation("VoidedByInvoice")
  debtsCreated       CustomerDebt[] @relation("DebtCreatedBy")
  debtsApproved      CustomerDebt[] @relation("DebtApprovedBy")
  debtPaymentsReceived CustomerDebtPayment[] @relation("DebtPaymentReceivedBy")

  posSessions  PosSession[]
  approvalLogs ApprovalLog[]
  auditLogs    AuditLog[] @relation("ActorAuditLog")
  requestedTerminalRequests TerminalRequest[] @relation("RequestedTerminalRequest")
  reviewedTerminalRequests  TerminalRequest[] @relation("ReviewedTerminalRequest")
  reviewedRegistrationRequests RegistrationRequest[] @relation("ReviewedRegistrationRequests")
  retryUnlockedRegistrationRequests RegistrationRequest[] @relation("RetryUnlockedRegistrationRequests")

  //////////////////////////////////////////////////
  // AUDIT
  //////////////////////////////////////////////////

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@index([companyId])
  @@map("profiles")
  @@schema("public")
}

model RegistrationRequest {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  fullName    String  @map("full_name")
  email       String
  phone       String?
  companyName String? @map("company_name")

  requestedRole UserRole @default(manager) @map("requested_role")
  status        RegistrationRequestStatus @default(pending)

  reviewedById   String?   @map("reviewed_by") @db.Uuid
  reviewedBy     Profile?  @relation("ReviewedRegistrationRequests", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt     DateTime? @map("reviewed_at") @db.Timestamptz
  rejectionReason String?  @map("rejection_reason")
  retryUnlockedById String? @map("retry_unlocked_by") @db.Uuid
  retryUnlockedBy   Profile? @relation("RetryUnlockedRegistrationRequests", fields: [retryUnlockedById], references: [id], onDelete: SetNull)
  retryUnlockedAt   DateTime? @map("retry_unlocked_at") @db.Timestamptz

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@index([email, status])
  @@index([status, createdAt])
  @@index([reviewedById])
  @@index([retryUnlockedById])
  @@map("registration_requests")
  @@schema("public")
}

/////////////////////////////////////////////////
// COMPANY
/////////////////////////////////////////////////

model Company {
  id String @id @default(dbgenerated("gen_random_uuid()")) @map("uuid_company") @db.Uuid

  name  String
  code  String?
  email String?
  phone String?
  address String?

  logoImageUrl String? @map("logo_img_url") @db.VarChar(500)

  //////////////////////////////////////////////////
  // RELATIONS
  //////////////////////////////////////////////////

  users        Profile[]
  images       CompanyImage[]
  posTerminals PosTerminalInfo[]
  terminalRequests TerminalRequest[]
  customers      Customer[]
  customerDebts  CustomerDebt[]
  debtPayments   CustomerDebtPayment[]

  //////////////////////////////////////////////////
  // AUDIT
  //////////////////////////////////////////////////

  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime   @updatedAt @map("updated_at") @db.Timestamptz
  categories Category[]
  products   Product[]
  auditLogs  AuditLog[]

  @@map("company")
  @@schema("public")
}

/////////////////////////////////////////////////
// COMPANY IMAGES
/////////////////////////////////////////////////

model CompanyImage {
  id        Int    @id @default(autoincrement())
  companyId String @map("company_id") @db.Uuid
  imageUrl  String @map("image_url")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("company_images")
  @@schema("public")
}

/////////////////////////////////////////////////
// POS TERMINAL
/////////////////////////////////////////////////

model PosTerminalInfo {
  id String @id @default(dbgenerated("gen_random_uuid()")) @map("uuid_pos_terminal") @db.Uuid

  // Regulatory
  minNumber           String?  @map("min_number")
  accreditationNumber String?  @map("accreditation_number")
  ptuNumber           String?  @map("ptu_number")
  dateIssued          DateTime @map("date_issued") @db.Date
  validUntil          DateTime @map("valid_until") @db.Date

  // Business
  posName        String?  @map("pos_name")
  registeredName String?  @map("registered_name")
  operatedBy     String?  @map("operated_by")
  address        String?
  vatTinNumber   String?  @map("vat_tin_number")
  vat            Int?
  discountCapType DiscountCapType @default(percent) @map("discount_cap_type")
  discountMax    Decimal? @map("discount_max") @db.Decimal(10, 2)
  allowCashierDebtCreate Boolean @default(false) @map("allow_cashier_debt_create")
  allowCashierDebtCollect Boolean @default(false) @map("allow_cashier_debt_collect")
  requireManagerApprovalForDebt Boolean @default(false) @map("require_manager_approval_for_debt")
  defaultDebtDueDays Int? @map("default_debt_due_days")

  // System
  printerName  String? @map("printer_name")
  printerDisplayName      String?               @map("printer_display_name")
  printerConnectionType   PrinterConnectionType? @map("printer_connection_type")
  printerTransport        PrinterTransport?      @map("printer_transport")
  printerDriver           PrinterDriver?         @map("printer_driver")
  printerVendorId         Int?                  @map("printer_vendor_id")
  printerProductId        Int?                  @map("printer_product_id")
  printerDeviceId         String?               @map("printer_device_id")
  printerServiceUuid      String?               @map("printer_service_uuid")
  printerCharacteristicUuid String?             @map("printer_characteristic_uuid")
  autoPrintEnabled        Boolean               @default(true) @map("auto_print_enabled")

  // Counters
  resetCounterNo      Int @default(0) @map("reset_counter_no")
  resetCounterTrainNo Int @default(0) @map("reset_counter_train_no")
  zCounterNo          Int @default(0) @map("z_counter_no")
  zCounterTrainNo     Int @default(0) @map("z_counter_train_no")

  // Modes
  isTrainMode  Boolean @default(false) @map("is_train_mode")
  isActive     Boolean @default(false) @map("is_active")

  //////////////////////////////////////////////////
  // RELATIONS
  //////////////////////////////////////////////////

  companyId String  @map("company_id") @db.Uuid
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  timestamps Timestamp[]
  subscription TerminalSubscription?

  //////////////////////////////////////////////////
  // AUDIT
  //////////////////////////////////////////////////

  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz
  invoices  Invoice[]
  sessions  PosSession[]
  auditLogs AuditLog[]
  customerDebts CustomerDebt[]
  debtPayments CustomerDebtPayment[]

  @@index([companyId])
  @@map("pos_terminal_info")
  @@schema("public")
}

/////////////////////////////////////////////////
// TERMINAL SUBSCRIPTION
/////////////////////////////////////////////////

model TerminalSubscription {
  id String @id @default(dbgenerated("gen_random_uuid()")) @map("uuid_terminal_subscription") @db.Uuid

  terminalId String          @unique @map("terminal_id") @db.Uuid
  terminal   PosTerminalInfo @relation(fields: [terminalId], references: [id], onDelete: Cascade)

  billingCycle SubscriptionBillingCycle @map("billing_cycle")
  status       SubscriptionStatus       @default(pending)

  startsAt  DateTime? @map("starts_at") @db.Date
  expiresAt DateTime? @map("expires_at") @db.Date
  renewedAt DateTime? @map("renewed_at") @db.Date

  autoRenew Boolean  @default(false) @map("auto_renew")
  price     Decimal? @db.Decimal(12, 2)
  notes     String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("terminal_subscription")
  @@schema("public")
}

/////////////////////////////////////////////////
// TERMINAL REQUEST
/////////////////////////////////////////////////

model TerminalRequest {
  id String @id @default(dbgenerated("gen_random_uuid()")) @map("uuid_terminal_request") @db.Uuid

  companyId String  @map("company_id") @db.Uuid
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  requestedById String  @map("requested_by_id") @db.Uuid
  requestedBy   Profile @relation("RequestedTerminalRequest", fields: [requestedById], references: [id])

  reviewedById String?  @map("reviewed_by_id") @db.Uuid
  reviewedBy   Profile? @relation("ReviewedTerminalRequest", fields: [reviewedById], references: [id])

  requestedTerminals Int                  @default(1) @map("requested_terminals")
  status             TerminalRequestStatus @default(pending)
  notes              String?

  reviewedAt DateTime? @map("reviewed_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  @@index([companyId])
  @@index([requestedById])
  @@index([reviewedById])
  @@map("terminal_request")
  @@schema("public")
}

/////////////////////////////////////////////////
// POS SESSION
/////////////////////////////////////////////////

model PosSession {
  id String @id @default(dbgenerated("gen_random_uuid()")) @map("uuid_pos_session") @db.Uuid

  loginTime  DateTime  @default(now()) @map("login_time") @db.Timestamptz
  logoutTime DateTime? @map("logout_time") @db.Timestamptz
  isActive   Boolean   @default(true) @map("is_active")

  //////////////////////////////////////////////////
  // RELATIONS
  //////////////////////////////////////////////////

  posTerminalId String          @map("pos_terminal_id") @db.Uuid
  posTerminal   PosTerminalInfo @relation(fields: [posTerminalId], references: [id])

  profileId String  @map("profile_id") @db.Uuid
  profile   Profile @relation(fields: [profileId], references: [id])

  @@index([posTerminalId])
  @@index([profileId])
  @@map("pos_session")
  @@schema("public")
}

/////////////////////////////////////////////////
// APPROVAL LOG
/////////////////////////////////////////////////

model ApprovalLog {
  id String @id @default(dbgenerated("gen_random_uuid()")) @map("uuid_approval_log") @db.Uuid

  actionType  String @map("action_type") // e.g. VOID_ITEM, CANCEL_INVOICE
  referenceId String @map("reference_id") @db.Uuid // the id of the voided item/invoice

  //////////////////////////////////////////////////
  // RELATIONS
  //////////////////////////////////////////////////

  managerId String  @map("manager_id") @db.Uuid
  manager   Profile @relation(fields: [managerId], references: [id])

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([managerId])
  @@map("approval_log")
  @@schema("public")
}

/////////////////////////////////////////////////
// AUDIT LOG
/////////////////////////////////////////////////

model AuditLog {
  id String @id @default(dbgenerated("gen_random_uuid()")) @map("uuid_audit_log") @db.Uuid

  companyId String  @map("company_id") @db.Uuid
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  actorProfileId String  @map("actor_profile_id") @db.Uuid
  actorProfile   Profile @relation("ActorAuditLog", fields: [actorProfileId], references: [id])

  posTerminalId String?         @map("pos_terminal_id") @db.Uuid
  posTerminal   PosTerminalInfo? @relation(fields: [posTerminalId], references: [id], onDelete: SetNull)

  actionType  String  @map("action_type")
  referenceId String? @map("reference_id") @db.Uuid
  changes     String?
  amount      Decimal? @db.Decimal(15, 2)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([companyId])
  @@index([actorProfileId])
  @@index([posTerminalId])
  @@index([createdAt])
  @@map("audit_log")
  @@schema("public")
}

/////////////////////////////////////////////////
// TIMESTAMP (POS ACTIVITY LOG)
/////////////////////////////////////////////////

model Timestamp {
  id String @id @default(dbgenerated("gen_random_uuid()")) @map("uuid_timestamp") @db.Uuid

  timestampIn  DateTime? @map("timestamp_in") @db.Timestamptz
  timestampOut DateTime? @map("timestamp_out") @db.Timestamptz

  cashInDrawerAmount    Decimal @default(0) @map("cash_in_drawer_amount") @db.Decimal(15, 2)
  cashOutDrawerAmount   Decimal @default(0) @map("cash_out_drawer_amount") @db.Decimal(15, 2)
  withdrawnDrawerAmount Decimal @default(0) @map("withdrawn_drawer_amount") @db.Decimal(15, 2)
  withdrawnDrawerCount  Decimal @default(0) @map("withdrawn_drawer_count") @db.Decimal(10, 2)

  //////////////////////////////////////////////////
  // RELATIONS
  //////////////////////////////////////////////////

  posTerminalId String          @map("pos_terminal_id") @db.Uuid
  posTerminal   PosTerminalInfo @relation(fields: [posTerminalId], references: [id])

  cashierId String  @map("cashier_id") @db.Uuid
  cashier   Profile @relation("CashierTimestamp", fields: [cashierId], references: [id])

  managerInId String?  @map("manager_in_id") @db.Uuid
  managerIn   Profile? @relation("ManagerInTimestamp", fields: [managerInId], references: [id])

  managerOutId String?  @map("manager_out_id") @db.Uuid
  managerOut   Profile? @relation("ManagerOutTimestamp", fields: [managerOutId], references: [id])

  forceClosedById String?  @map("force_closed_by_id") @db.Uuid
  forceClosedBy   Profile? @relation("ForceClosedByTimestamp", fields: [forceClosedById], references: [id])

  deviceId String? @map("device_id")
  lastSeenAt DateTime? @map("last_seen_at") @db.Timestamptz
  forceClosedAt DateTime? @map("force_closed_at") @db.Timestamptz
  forceCloseReason String? @map("force_close_reason")
  debtPayments CustomerDebtPayment[]

  //////////////////////////////////////////////////
  // AUDIT
  //////////////////////////////////////////////////

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([posTerminalId])
  @@index([cashierId])
  @@index([deviceId])
  @@map("timestamp")
  @@schema("public")
}

/////////////////////////////////////////////////
// ENUMS
/////////////////////////////////////////////////

enum ItemType {
  RESALE
  WHOLESALE

  @@map("item_type")
  @@schema("public")
}

enum VatType {
  VATABLE
  EXEMPT
  ZERO

  @@map("vat_type")
  @@schema("public")
}

enum InventoryTransactionType {
  IN
  OUT
  ADJUSTMENT

  @@map("inventory_transaction_type")
  @@schema("public")
}

/////////////////////////////////////////////////
// CATEGORY
/////////////////////////////////////////////////

model Category {
  id String @id @default(dbgenerated("gen_random_uuid()")) @map("uuid_category") @db.Uuid

  categoryName String? @map("category_name")

  //////////////////////////////////////////////////
  // RELATIONS
  //////////////////////////////////////////////////

  companyId String?  @map("uuid_company") @db.Uuid
  company   Company? @relation(fields: [companyId], references: [id])

  products Product[]

  //////////////////////////////////////////////////
  // AUDIT
  //////////////////////////////////////////////////

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  @@index([companyId])
  @@map("category")
  @@schema("public")
}

/////////////////////////////////////////////////
// PRODUCT
/////////////////////////////////////////////////

model Product {
  id String @id @default(dbgenerated("gen_random_uuid()")) @map("uuid_product") @db.Uuid

  name            String
  productImageUrl String?  @map("product_image_url") @db.VarChar(500)
  barcode         String?  @db.VarChar(100)
  baseUnit        String   @default("") @map("base_unit") @db.VarChar(50)
  quantity        Decimal? @db.Decimal(19, 4)
  cost            Decimal  @default(0) @db.Decimal(19, 4)
  price           Decimal  @db.Decimal(19, 4)
  isAvailable     Boolean  @default(true) @map("is_available")
  trackInventory  Boolean  @default(false) @map("track_inventory")
  itemType        ItemType @default(RESALE) @map("item_type")
  vatType         VatType  @default(VATABLE) @map("vat_type")

  //////////////////////////////////////////////////
  // RELATIONS
  //////////////////////////////////////////////////

  categoryId String   @map("uuid_category") @db.Uuid
  category   Category @relation(fields: [categoryId], references: [id])

  companyId String?  @map("uuid_company") @db.Uuid
  company   Company? @relation(fields: [companyId], references: [id])

  images    ProductImage[]
  inventory Inventory[]

  //////////////////////////////////////////////////
  // AUDIT
  //////////////////////////////////////////////////

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz
  items     Item[]

  @@unique([name, categoryId], name: "uk_product_name_category")
  @@index([categoryId])
  @@index([companyId])
  @@map("product")
  @@schema("public")
}

/////////////////////////////////////////////////
// PRODUCT IMAGES
/////////////////////////////////////////////////

model ProductImage {
  id       Int    @id @default(autoincrement())
  imageUrl String @map("image_url")

  productId String  @map("uuid_product") @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
  @@schema("public")
}

/////////////////////////////////////////////////
// INVENTORY
/////////////////////////////////////////////////

model Inventory {
  id String @id @default(dbgenerated("gen_random_uuid()")) @map("uuid_inventory") @db.Uuid

  quantity  Decimal                  @db.Decimal(19, 4)
  type      InventoryTransactionType
  reference String?

  //////////////////////////////////////////////////
  // RELATIONS
  //////////////////////////////////////////////////

  productId String  @map("uuid_product") @db.Uuid
  product   Product @relation(fields: [productId], references: [id])

  //////////////////////////////////////////////////
  // AUDIT
  //////////////////////////////////////////////////

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@index([productId])
  @@map("inventory")
  @@schema("public")
}

/////////////////////////////////////////////////
// ENUMS For INVOICE
/////////////////////////////////////////////////

enum DiscountType {
  PWD
  SENIOR
  OTHERS

  @@map("discount_type")
  @@schema("public")
}

enum InvoiceDocumentType {
  INVOICE
  ZREPORT
  XREPORT

  @@map("invoice_document_type")
  @@schema("public")
}

enum InvoiceStatusType {
  CANCELLED
  RETURNED
  VOID
  PENDING
  PAID

  @@map("invoice_status_type")
  @@schema("public")
}

enum SaleTypeEnums {
  CARD
  EPAYMENT

  @@map("sale_type_enums")
  @@schema("public")
}

/////////////////////////////////////////////////
// SALE TYPE
/////////////////////////////////////////////////

model SaleType {
  id String @id @default(dbgenerated("gen_random_uuid()")) @map("uuid_sale_type") @db.Uuid

  name    String?
  account String?
  type    SaleTypeEnums @default(EPAYMENT)

  //////////////////////////////////////////////////
  // RELATIONS
  //////////////////////////////////////////////////

  ePayments EPayment[]

  //////////////////////////////////////////////////
  // AUDIT
  //////////////////////////////////////////////////

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("sale_type")
  @@schema("public")
}

/////////////////////////////////////////////////
// INVOICE
/////////////////////////////////////////////////

model Invoice {
  id String @id @default(dbgenerated("gen_random_uuid()")) @map("uuid_invoice") @db.Uuid

  /**
   * -------------------------
   * Invoice Identifiers
   * -------------------------
   */

  invoiceNumber Int @map("invoice_number")
  idempotencyKey String? @unique @map("idempotency_key")
  sourceDeviceId String? @map("source_device_id")
  sourceTimestampId String? @map("source_timestamp_id") @db.Uuid
  localInvoiceNo String? @map("local_invoice_no")

  /**
   * -------------------------
   * Amounts
   * -------------------------
   */

  grossAmount   Decimal  @map("gross_amount") @db.Decimal(15, 2)
  totalAmount   Decimal  @map("total_amount") @db.Decimal(15, 2)
  subTotal      Decimal? @map("sub_total") @db.Decimal(15, 2)
  cashTendered  Decimal? @map("cash_tendered") @db.Decimal(15, 2)
  dueAmount     Decimal? @map("due_amount") @db.Decimal(15, 2)
  totalTendered Decimal? @map("total_tendered") @db.Decimal(15, 2)
  changeAmount  Decimal? @map("change_amount") @db.Decimal(15, 2)
  vatSales      Decimal? @map("vat_sales") @db.Decimal(15, 2)
  vatExempt     Decimal? @map("vat_exempt") @db.Decimal(15, 2)
  vatAmount     Decimal? @map("vat_amount") @db.Decimal(15, 2)
  vatZero       Decimal? @map("vat_zero") @db.Decimal(15, 2)

  /**
   * -------------------------
   * Customer & Discount
   * -------------------------
   */

  customerName     String   @default("Walk-in Customer") @map("customer_name")
  eligibleDiscName String?  @map("eligible_disc_name")
  oscaIdNum        String?  @map("osca_id_num")
  discountType     String?  @map("discount_type")
  discountPercent  Int?     @map("discount_percent")
  discountAmount   Decimal? @map("discount_amount") @db.Decimal(15, 2)

  /**
   * -------------------------
   * Return / Void
   * -------------------------
   */

  returnedAmount Decimal? @map("returned_amount") @db.Decimal(15, 2)
  reason         String?

  /**
   * -------------------------
   * Status & Metadata
   * -------------------------
   */

  status      InvoiceStatusType
  isRead      Boolean           @default(false) @map("is_read")
  isTrainMode Boolean           @default(false) @map("is_train_mode")

  //////////////////////////////////////////////////
  // RELATIONS
  //////////////////////////////////////////////////

  posTerminalId String          @map("uuid_pos_terminal") @db.Uuid
  posTerminal   PosTerminalInfo @relation(fields: [posTerminalId], references: [id])

  cashierId String  @map("cashier_id") @db.Uuid
  cashier   Profile @relation("CashierInvoice", fields: [cashierId], references: [id])

  voidedById String?  @map("voided_by") @db.Uuid
  voidedBy   Profile? @relation("VoidedByInvoice", fields: [voidedById], references: [id])

  items     Item[]
  ePayments EPayment[]
  documents InvoiceDocument[]
  customerDebt CustomerDebt?

  //////////////////////////////////////////////////
  // AUDIT
  //////////////////////////////////////////////////

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@index([posTerminalId])
  @@index([cashierId])
  @@index([voidedById])
  @@index([posTerminalId, isTrainMode, invoiceNumber])
  @@unique([posTerminalId, invoiceNumber], name: "uk_invoice_terminal_invoice_number")
  @@map("invoice")
  @@schema("public")
}

enum DebtStatus {
  UNPAID
  PARTIAL
  PAID
  CANCELLED

  @@map("debt_status")
  @@schema("public")
}

model Customer {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  companyId String @map("company_id") @db.Uuid
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name String
  phone String?
  address String?
  notes String?
  isActive Boolean @default(true) @map("is_active")

  debts CustomerDebt[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@index([companyId, isActive])
  @@index([companyId, name])
  @@map("customer")
  @@schema("public")
}

model CustomerDebt {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  companyId String @map("company_id") @db.Uuid
  terminalId String? @map("terminal_id") @db.Uuid
  customerId String @map("customer_id") @db.Uuid
  invoiceId String @unique @map("invoice_id") @db.Uuid

  originalAmount Decimal @map("original_amount") @db.Decimal(15, 2)
  paidAmount Decimal @default(0) @map("paid_amount") @db.Decimal(15, 2)
  remainingAmount Decimal @map("remaining_amount") @db.Decimal(15, 2)
  status DebtStatus @default(UNPAID)
  dueDate DateTime @map("due_date") @db.Timestamptz
  paidAt DateTime? @map("paid_at") @db.Timestamptz
  cancelledAt DateTime? @map("cancelled_at") @db.Timestamptz
  notes String?

  createdById String @map("created_by_id") @db.Uuid
  approvedById String? @map("approved_by_id") @db.Uuid

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  terminal PosTerminalInfo? @relation(fields: [terminalId], references: [id], onDelete: SetNull)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  createdBy Profile @relation("DebtCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy Profile? @relation("DebtApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  payments CustomerDebtPayment[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@index([companyId, status])
  @@index([terminalId])
  @@index([customerId])
  @@index([dueDate])
  @@index([createdById])
  @@index([approvedById])
  @@map("customer_debt")
  @@schema("public")
}

model CustomerDebtPayment {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  debtId String @map("debt_id") @db.Uuid
  companyId String @map("company_id") @db.Uuid
  terminalId String? @map("terminal_id") @db.Uuid
  timestampId String? @map("timestamp_id") @db.Uuid
  amount Decimal @db.Decimal(15, 2)
  method String
  referenceNo String? @map("reference_no")
  notes String?
  receivedById String @map("received_by_id") @db.Uuid

  debt CustomerDebt @relation(fields: [debtId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  terminal PosTerminalInfo? @relation(fields: [terminalId], references: [id], onDelete: SetNull)
  timestamp Timestamp? @relation(fields: [timestampId], references: [id], onDelete: SetNull)
  receivedBy Profile @relation("DebtPaymentReceivedBy", fields: [receivedById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@index([debtId, createdAt])
  @@index([companyId, createdAt])
  @@index([terminalId])
  @@index([timestampId])
  @@index([receivedById])
  @@map("customer_debt_payment")
  @@schema("public")
}

model InvoiceDocument {
  id String @id @default(dbgenerated("gen_random_uuid()")) @map("uuid_invoice_document") @db.Uuid

  invoiceBlob  Bytes               @map("invoice_blob")
  type         InvoiceDocumentType
  reprintCount Int                 @default(0) @map("reprint_count")
  isTrainMode  Boolean             @default(false) @map("is_train_mode")

  invoiceId String?  @map("invoice_id") @db.Uuid
  invoice   Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@index([invoiceId])
  @@index([type, createdAt])
  @@map("invoice_document")
  @@schema("public")
}

/////////////////////////////////////////////////
// ITEM
/////////////////////////////////////////////////

model Item {
  id String @id @default(dbgenerated("gen_random_uuid()")) @map("uuid_item") @db.Uuid

  qty      Decimal           @db.Decimal(19, 4)
  price    Decimal           @db.Decimal(19, 4)
  subTotal Decimal           @map("subtotal") @db.Decimal(19, 4)
  status   InvoiceStatusType

  isTrainingMode Boolean @default(false) @map("is_training_mode")

  productId String  @map("uuid_product") @db.Uuid
  product   Product @relation(fields: [productId], references: [id])

  invoiceId String  @map("uuid_invoice") @db.Uuid
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@index([productId])
  @@index([invoiceId])
  @@map("item")
  @@schema("public")
}

/////////////////////////////////////////////////
// E-PAYMENT
/////////////////////////////////////////////////

model EPayment {
  id String @id @default(dbgenerated("gen_random_uuid()")) @map("uuid_e_payment") @db.Uuid

  reference String  @unique
  amount    Decimal @db.Decimal(15, 2)

  //////////////////////////////////////////////////
  // RELATIONS
  //////////////////////////////////////////////////

  invoiceId String  @map("uuid_invoice") @db.Uuid
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  saleTypeId String   @map("uuid_sale_type") @db.Uuid
  saleType   SaleType @relation(fields: [saleTypeId], references: [id])

  //////////////////////////////////////////////////
  // AUDIT
  //////////////////////////////////////////////////

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@index([invoiceId])
  @@index([saleTypeId])
  @@map("e_payment")
  @@schema("public")
}
