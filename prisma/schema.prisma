enum ItemType {
  RESALE
  WHOLESALE

  @@map("item_type")
  @@schema("public")
}

enum VatType {
  VATABLE
  EXEMPT
  ZERO

  @@map("vat_type")
  @@schema("public")
}

enum InventoryTransactionType {
