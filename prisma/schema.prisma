generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["public"]
}

/////////////////////////////////////////////////
// ENUMS
/////////////////////////////////////////////////

enum UserRole {
  admin
  manager
  cashier

  @@map("user_role")
  @@schema("public")
}

enum UserStatus {
  pending
  active
  disabled

  @@map("user_status")
  @@schema("public")
}

enum PermissionKey {
  VIEW_DASHBOARD
  VIEW_POS
  VIEW_INVENTORY
  VIEW_TRANSACTIONS
  VIEW_ACCOUNTS
  VIEW_REPORTS
  VIEW_AI_REPORTS
  VIEW_PROFILE
  VIEW_HELP
  VIEW_COMPANY
  VIEW_COMPANY_SETTINGS
  VIEW_COMPANY_TERMINALS
  VIEW_COMPANY_SUBSCRIPTION
  VIEW_PRODUCT
  VIEW_ADMIN
  VIEW_ADMIN_SETTINGS
  VIEW_ADMIN_TERMINALS
  VIEW_ADMIN_SUBSCRIPTIONS
  VIEW_ADMIN_APPROVALS
  VIEW_NOTIFICATIONS
  MANAGE_PRODUCTS
  MANAGE_INVENTORY
  MANAGE_SUPPLIERS
  MANAGE_PURCHASE_ORDERS
  MANAGE_RECEIVING
  MANAGE_TRANSFERS
  MANAGE_EXPENSES
  MANAGE_CUSTOMERS
  MANAGE_LOYALTY
  MANAGE_PROMOTIONS
  MANAGE_KITCHEN
  APPROVE_REQUESTS
  APPROVE_DISCOUNTS
  APPROVE_REFUNDS
  APPROVE_STOCK_ADJUSTMENTS
  APPROVE_EXPENSES
  APPROVE_TRANSFERS
  MANAGE_USERS
  MANAGE_TERMINALS
  VIEW_AUDIT_TRAIL
  MANAGE_NOTIFICATIONS
  VIEW_SYNC_CENTER
  RESOLVE_SYNC_CONFLICTS

  @@map("permission_key")
  @@schema("public")
}

enum PermissionEffect {
  allow
  deny

  @@map("permission_effect")
  @@schema("public")
}

enum TerminalRequestStatus {
  pending
  approved
  fulfilled
  rejected
  cancelled

  @@map("terminal_request_status")
  @@schema("public")
}

enum SubscriptionBillingCycle {
  monthly
  quarterly
  annually

  @@map("subscription_billing_cycle")
  @@schema("public")
}

enum SubscriptionStatus {
  pending
  active
  expired
  suspended
  cancelled

  @@map("subscription_status")
  @@schema("public")
}

enum RegistrationRequestStatus {
  pending
  approved
  rejected

  @@map("registration_request_status")
  @@schema("public")
}

enum NotificationCategory {
  REGISTRATION
  TERMINAL_REQUEST
  APPROVAL
  SYSTEM
  REPORT

  @@map("notification_category")
  @@schema("public")
}

enum NotificationDeliveryChannel {
  IN_APP
  EMAIL

  @@map("notification_delivery_channel")
  @@schema("public")
}

enum NotificationDeliveryStatus {
  pending
  sent
  skipped
  failed

  @@map("notification_delivery_status")
  @@schema("public")
}

enum ApprovalRequestStatus {
  pending
  approved
  rejected
  expired
  cancelled
  executed

  @@map("approval_request_status")
  @@schema("public")
}

enum ApprovalDecisionStatus {
  approved
  rejected
  cancelled

  @@map("approval_decision_status")
  @@schema("public")
}

enum PrinterConnectionType {
  usb
  bluetooth
  serial
  built_in

  @@map("printer_connection_type")
  @@schema("public")
}

enum PrinterTransport {
  usb
  bluetooth
  built_in

  @@map("printer_transport")
  @@schema("public")
}

enum PrinterDriver {
  webusb
  webbluetooth
  webserial
  sunmi_native

  @@map("printer_driver")
  @@schema("public")
}

enum DiscountCapType {
  percent
  amount

  @@map("discount_cap_type")
  @@schema("public")
}

enum BusinessMode {
  RETAIL
  RESTAURANT
  HYBRID

  @@map("business_mode")
  @@schema("public")
}

enum FulfillmentType {
  WALK_IN
  DINE_IN
  TAKE_OUT
  DELIVERY
  PICKUP

  @@map("fulfillment_type")
  @@schema("public")
}

enum ModifierGroupType {
  VARIANT
  MODIFIER
  ADDON
  INSTRUCTION

  @@map("modifier_group_type")
  @@schema("public")
}

/////////////////////////////////////////////////
// PROFILE (Single User Source)
/////////////////////////////////////////////////

model Profile {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @unique @map("user_id") @db.Uuid
  email  String @unique

  fullName String? @map("full_name")

  role   UserRole   @default(manager)
  status UserStatus @default(pending)

  pin String? @db.VarChar(128)

  approvedAt DateTime? @map("approved_at") @db.Timestamptz

  //////////////////////////////////////////////////
  // RELATIONS
  //////////////////////////////////////////////////

  companyId String?  @map("company_id") @db.Uuid
  company   Company? @relation(fields: [companyId], references: [id])

  branchId String? @map("branch_id") @db.Uuid
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  timestampsAsCashier     Timestamp[] @relation("CashierTimestamp")
  timestampsAsManagerIn   Timestamp[] @relation("ManagerInTimestamp")
  timestampsAsManagerOut  Timestamp[] @relation("ManagerOutTimestamp")
  timestampsAsForceClosed Timestamp[] @relation("ForceClosedByTimestamp")

  invoicesAsCashier    Invoice[]             @relation("CashierInvoice")
  invoicesAsVoidedBy   Invoice[]             @relation("VoidedByInvoice")
  returnsProcessed     InvoiceReturn[]       @relation("ReturnProcessedBy")
  returnsApproved      InvoiceReturn[]       @relation("ReturnApprovedBy")
  debtsCreated         CustomerDebt[]        @relation("DebtCreatedBy")
  debtsApproved        CustomerDebt[]        @relation("DebtApprovedBy")
  debtPaymentsReceived CustomerDebtPayment[] @relation("DebtPaymentReceivedBy")

  posSessions                       PosSession[]
  approvalLogs                      ApprovalLog[]
  approvalRequests                  ApprovalRequest[]    @relation("RequestedApprovalRequests")
  approvalDecisions                 ApprovalDecision[]   @relation("DecidedApprovalRequests")
  rolePermissions                   RolePermission[]     @relation("CreatedRolePermissions")
  userPermissionOverrides           UserPermissionOverride[] @relation("UserPermissionOverrideTarget")
  permissionOverridesCreated        UserPermissionOverride[] @relation("CreatedUserPermissionOverrides")
  expensesCreated                   Expense[]            @relation("ExpenseCreatedBy")
  expensesApproved                  Expense[]            @relation("ExpenseApprovedBy")
  nonSalesIncomesCreated            NonSalesIncome[]     @relation("NonSalesIncomeCreatedBy")
  stockMovementsCreated             StockMovement[]      @relation("StockMovementCreatedBy")
  stockCountsCreated                 StockCountSession[]  @relation("StockCountCreatedBy")
  stockCountsAssigned                StockCountSession[]  @relation("StockCountAssignedTo")
  stockCountsSubmitted               StockCountSession[]  @relation("StockCountSubmittedBy")
  stockCountsApproved                StockCountSession[]  @relation("StockCountApprovedBy")
  revenueGoalsCreated                RevenueGoal[]        @relation("RevenueGoalCreatedBy")
  purchaseOrdersCreated             PurchaseOrder[]      @relation("PurchaseOrderCreatedBy")
  purchaseOrdersApproved            PurchaseOrder[]      @relation("PurchaseOrderApprovedBy")
  receivingRecordsPosted            ReceivingRecord[]    @relation("ReceivingPostedBy")
  branchTransfersRequested          BranchTransfer[]     @relation("BranchTransferRequestedBy")
  branchTransfersApproved           BranchTransfer[]     @relation("BranchTransferApprovedBy")
  branchTransfersReceived           BranchTransfer[]     @relation("BranchTransferReceivedBy")
  managedBranches                   Branch[]             @relation("BranchManager")
  loyaltyTransactionsCreated        LoyaltyTransaction[] @relation("LoyaltyTransactionCreatedBy")
  kitchenTicketsUpdated             KitchenTicket[]      @relation("KitchenTicketUpdatedBy")
  auditLogs                         AuditLog[]            @relation("ActorAuditLog")
  requestedTerminalRequests         TerminalRequest[]     @relation("RequestedTerminalRequest")
  reviewedTerminalRequests          TerminalRequest[]     @relation("ReviewedTerminalRequest")
  reviewedRegistrationRequests      RegistrationRequest[] @relation("ReviewedRegistrationRequests")
  retryUnlockedRegistrationRequests RegistrationRequest[] @relation("RetryUnlockedRegistrationRequests")
  notifications                     UserNotification[]
  aiReportConversations             AiReportConversation[]

  //////////////////////////////////////////////////
  // AUDIT
  //////////////////////////////////////////////////

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@index([companyId])
  @@index([branchId])
  @@map("profiles")
  @@schema("public")
}

model RegistrationRequest {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  fullName    String  @map("full_name")
  email       String
  phone       String?
  companyName String? @map("company_name")

  requestedRole UserRole                  @default(manager) @map("requested_role")
  status        RegistrationRequestStatus @default(pending)

  reviewedById      String?   @map("reviewed_by") @db.Uuid
  reviewedBy        Profile?  @relation("ReviewedRegistrationRequests", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt        DateTime? @map("reviewed_at") @db.Timestamptz
  rejectionReason   String?   @map("rejection_reason")
  retryUnlockedById String?   @map("retry_unlocked_by") @db.Uuid
  retryUnlockedBy   Profile?  @relation("RetryUnlockedRegistrationRequests", fields: [retryUnlockedById], references: [id], onDelete: SetNull)
  retryUnlockedAt   DateTime? @map("retry_unlocked_at") @db.Timestamptz

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@index([email, status])
  @@index([status, createdAt])
  @@index([reviewedById])
  @@index([retryUnlockedById])
  @@map("registration_requests")
  @@schema("public")
}

model SystemConfiguration {
  id String @id @default("default")

  directRegistrationEnabled Boolean @default(false) @map("direct_registration_enabled")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("system_configuration")
  @@schema("public")
}

model UserNotification {
  id String @id @default(dbgenerated("gen_random_uuid()")) @map("uuid_user_notification") @db.Uuid

  profileId String  @map("profile_id") @db.Uuid
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  companyId String? @map("company_id") @db.Uuid

  category       NotificationCategory
  type           String
  title          String
  body           String
  href           String?
  relatedEntityType String? @map("related_entity_type")
  relatedEntityId   String? @map("related_entity_id")
  metadata       Json?

  deliveryChannel NotificationDeliveryChannel @default(IN_APP) @map("delivery_channel")
  deliveryStatus  NotificationDeliveryStatus  @default(sent) @map("delivery_status")
  readAt          DateTime?                   @map("read_at") @db.Timestamptz

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@index([profileId, readAt, createdAt])
  @@index([companyId, createdAt])
  @@index([category, createdAt])
  @@map("user_notification")
  @@schema("public")
}

/////////////////////////////////////////////////
// COMPANY
/////////////////////////////////////////////////

model Company {
  id String @id @default(dbgenerated("gen_random_uuid()")) @map("uuid_company") @db.Uuid

  name    String
  code    String?
  email   String?
  phone   String?
  address String?

  logoImageUrl           String?         @map("logo_img_url") @db.VarChar(500)
  businessMode           BusinessMode    @default(RETAIL) @map("business_mode")
  defaultFulfillmentType FulfillmentType @default(WALK_IN) @map("default_fulfillment_type")
  enableFulfillmentTypes Boolean         @default(false) @map("enable_fulfillment_types")
  enableTableService     Boolean         @default(false) @map("enable_table_service")
  enableDeliveryDetails  Boolean         @default(false) @map("enable_delivery_details")
  enableProductModifiers Boolean         @default(false) @map("enable_product_modifiers")
  enableKitchenTickets   Boolean         @default(false) @map("enable_kitchen_tickets")

  //////////////////////////////////////////////////
  // RELATIONS
  //////////////////////////////////////////////////

  users            Profile[]
  branches         Branch[]
  images           CompanyImage[]
  posTerminals     PosTerminalInfo[]
  terminalRequests TerminalRequest[]
  rolePermissions   RolePermission[]
  permissionOverrides UserPermissionOverride[]
  approvalRequests  ApprovalRequest[]
  syncIssues        OfflineSyncIssue[]
  expenseCategories ExpenseCategory[]
  expenses          Expense[]
  nonSalesIncomes   NonSalesIncome[]
  stockMovements    StockMovement[]
  stockLots         StockLot[]
  stockCountSessions StockCountSession[]
  revenueGoals     RevenueGoal[]
  suppliers         Supplier[]
  purchaseOrders    PurchaseOrder[]
  receivingRecords  ReceivingRecord[]
  branchTransfers   BranchTransfer[]
  loyaltyTransactions LoyaltyTransaction[]
  promotions        Promotion[]
  kitchenTickets    KitchenTicket[]
  customers        Customer[]
  customerDebts    CustomerDebt[]
  debtPayments     CustomerDebtPayment[]
  invoiceReturns   InvoiceReturn[]

  //////////////////////////////////////////////////
  // AUDIT
  //////////////////////////////////////////////////

  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz
  categories     Category[]
  products       Product[]
  modifierGroups ModifierGroup[]
  auditLogs      AuditLog[]

  @@map("company")
  @@schema("public")
}

model RevenueGoal {
  id String @id @default(dbgenerated("gen_random_uuid()")) @map("uuid_revenue_goal") @db.Uuid

  companyId String  @map("company_id") @db.Uuid
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  month        DateTime @db.Date
  targetAmount Decimal  @map("target_amount") @db.Decimal(19, 4)
  notes        String?

  createdById String?  @map("created_by_id") @db.Uuid
  createdBy   Profile? @relation("RevenueGoalCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([companyId, month], name: "uk_revenue_goal_company_month")
  @@index([companyId, month])
  @@index([createdById])
  @@map("revenue_goal")
  @@schema("public")
}

/////////////////////////////////////////////////
// COMPANY IMAGES
/////////////////////////////////////////////////

model Branch {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  name     String
  code     String?
  address  String?
  phone    String?
  email    String?
  isActive Boolean @default(true) @map("is_active")
  timezone String? @default("Asia/Manila")
  currency String? @default("PHP")
  taxMode  String? @default("inherit") @map("tax_mode")
  taxRate  Decimal? @map("tax_rate") @db.Decimal(5, 2)
  receiptFooter String? @map("receipt_footer")
  logoImageUrl  String? @map("logo_image_url") @db.VarChar(500)
  openingDate   DateTime? @map("opening_date") @db.Date
  invoicePrefix String? @map("invoice_prefix") @db.VarChar(20)
  invoiceCounter Int @default(0) @map("invoice_counter")
  settings Json?

  companyId String  @map("company_id") @db.Uuid
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  managerId String? @map("manager_id") @db.Uuid
  manager   Profile? @relation("BranchManager", fields: [managerId], references: [id], onDelete: SetNull)

  cashiers     Profile[]
  posTerminals PosTerminalInfo[]
  timestamps   Timestamp[]
  invoices     Invoice[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([companyId, name])
  @@unique([companyId, code])
  @@index([companyId, isActive])
  @@index([managerId])
  @@map("branch")
  @@schema("public")
}

model CompanyImage {
  id        Int    @id @default(autoincrement())
  companyId String @map("company_id") @db.Uuid
  imageUrl  String @map("image_url")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("company_images")
  @@schema("public")
}

/////////////////////////////////////////////////
// POS TERMINAL
/////////////////////////////////////////////////

model PosTerminalInfo {
  id String @id @default(dbgenerated("gen_random_uuid()")) @map("uuid_pos_terminal") @db.Uuid

  // Regulatory
  minNumber           String?  @map("min_number")
  accreditationNumber String?  @map("accreditation_number")
  ptuNumber           String?  @map("ptu_number")
  dateIssued          DateTime @map("date_issued") @db.Date
  validUntil          DateTime @map("valid_until") @db.Date

  // Business
  posName                       String?         @map("pos_name")
  registeredName                String?         @map("registered_name")
  operatedBy                    String?         @map("operated_by")
  address                       String?
  vatTinNumber                  String?         @map("vat_tin_number")
  vat                           Int?
  discountCapType               DiscountCapType @default(percent) @map("discount_cap_type")
  discountMax                   Decimal?        @map("discount_max") @db.Decimal(10, 2)
  allowCashierDebtCreate        Boolean         @default(false) @map("allow_cashier_debt_create")
  allowCashierDebtCollect       Boolean         @default(false) @map("allow_cashier_debt_collect")
  requireManagerApprovalForDebt Boolean         @default(false) @map("require_manager_approval_for_debt")
  defaultDebtDueDays            Int?            @map("default_debt_due_days")
  businessModeOverride          BusinessMode?   @map("business_mode_override")
  enableFulfillmentTypes        Boolean         @default(false) @map("enable_fulfillment_types")
  enableRestaurantFeatures      Boolean         @default(false) @map("enable_restaurant_features")
  enableTableService            Boolean         @default(false) @map("enable_table_service")
  enableDeliveryDetails         Boolean         @default(false) @map("enable_delivery_details")
  enableProductModifiers        Boolean         @default(false) @map("enable_product_modifiers")
  enableKitchenTickets          Boolean         @default(false) @map("enable_kitchen_tickets")

  // System
  printerName               String?                @map("printer_name")
  printerDisplayName        String?                @map("printer_display_name")
  printerConnectionType     PrinterConnectionType? @map("printer_connection_type")
  printerTransport          PrinterTransport?      @map("printer_transport")
  printerDriver             PrinterDriver?         @map("printer_driver")
  printerVendorId           Int?                   @map("printer_vendor_id")
  printerProductId          Int?                   @map("printer_product_id")
  printerDeviceId           String?                @map("printer_device_id")
  printerServiceUuid        String?                @map("printer_service_uuid")
  printerCharacteristicUuid String?                @map("printer_characteristic_uuid")
  autoPrintEnabled          Boolean                @default(true) @map("auto_print_enabled")

  // Counters
  resetCounterNo      Int @default(0) @map("reset_counter_no")
  resetCounterTrainNo Int @default(0) @map("reset_counter_train_no")
  zCounterNo          Int @default(0) @map("z_counter_no")
  zCounterTrainNo     Int @default(0) @map("z_counter_train_no")

  // Modes
  isDefaultTerminal Boolean @default(false) @map("is_default_terminal")
  isTrainMode       Boolean @default(false) @map("is_train_mode")
  isActive          Boolean @default(false) @map("is_active")

  //////////////////////////////////////////////////
  // RELATIONS
  //////////////////////////////////////////////////

  companyId String  @map("company_id") @db.Uuid
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  branchId String? @map("branch_id") @db.Uuid
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  timestamps   Timestamp[]
  subscription TerminalSubscription?

  //////////////////////////////////////////////////
  // AUDIT
  //////////////////////////////////////////////////

  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime              @updatedAt @map("updated_at") @db.Timestamptz
  invoices             Invoice[]
  invoiceReturns       InvoiceReturn[]
  sessions             PosSession[]
  auditLogs            AuditLog[]
  approvalRequests     ApprovalRequest[]
  syncIssues           OfflineSyncIssue[]
  expenses             Expense[]
  nonSalesIncomes      NonSalesIncome[]
  stockMovements       StockMovement[]
  branchTransfersFrom  BranchTransfer[] @relation("SourceTerminalTransfers")
  branchTransfersTo    BranchTransfer[] @relation("DestinationTerminalTransfers")
  kitchenTickets       KitchenTicket[]
  customerDebts        CustomerDebt[]
  debtPayments         CustomerDebtPayment[]
  customerDisplayState CustomerDisplayState?

  @@index([companyId])
  @@map("pos_terminal_info")
  @@schema("public")
}

model CustomerDisplayState {
  id String @id @default(dbgenerated("gen_random_uuid()")) @map("uuid_customer_display_state") @db.Uuid

  terminalId String          @unique @map("terminal_id") @db.Uuid
  terminal   PosTerminalInfo @relation(fields: [terminalId], references: [id], onDelete: Cascade)

  companyId String @map("company_id") @db.Uuid
  payload   Json

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@index([companyId])
  @@index([terminalId, updatedAt])
  @@map("customer_display_state")
  @@schema("public")
}

/////////////////////////////////////////////////
// TERMINAL SUBSCRIPTION
/////////////////////////////////////////////////

model TerminalSubscription {
  id String @id @default(dbgenerated("gen_random_uuid()")) @map("uuid_terminal_subscription") @db.Uuid

  terminalId String          @unique @map("terminal_id") @db.Uuid
  terminal   PosTerminalInfo @relation(fields: [terminalId], references: [id], onDelete: Cascade)

  billingCycle SubscriptionBillingCycle @map("billing_cycle")
  status       SubscriptionStatus       @default(pending)

  startsAt  DateTime? @map("starts_at") @db.Date
  expiresAt DateTime? @map("expires_at") @db.Date
  renewedAt DateTime? @map("renewed_at") @db.Date

  autoRenew Boolean  @default(false) @map("auto_renew")
  price     Decimal? @db.Decimal(12, 2)
  notes     String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("terminal_subscription")
  @@schema("public")
}

/////////////////////////////////////////////////
// TERMINAL REQUEST
/////////////////////////////////////////////////

model TerminalRequest {
  id String @id @default(dbgenerated("gen_random_uuid()")) @map("uuid_terminal_request") @db.Uuid

  companyId String  @map("company_id") @db.Uuid
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  requestedById String  @map("requested_by_id") @db.Uuid
  requestedBy   Profile @relation("RequestedTerminalRequest", fields: [requestedById], references: [id])

  reviewedById String?  @map("reviewed_by_id") @db.Uuid
  reviewedBy   Profile? @relation("ReviewedTerminalRequest", fields: [reviewedById], references: [id])

  requestedTerminals Int                   @default(1) @map("requested_terminals")
  status             TerminalRequestStatus @default(pending)
  notes              String?

  reviewedAt DateTime? @map("reviewed_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  @@index([companyId])
  @@index([requestedById])
  @@index([reviewedById])
  @@map("terminal_request")
  @@schema("public")
}

/////////////////////////////////////////////////
// POS SESSION
/////////////////////////////////////////////////

model PosSession {
  id String @id @default(dbgenerated("gen_random_uuid()")) @map("uuid_pos_session") @db.Uuid

  loginTime  DateTime  @default(now()) @map("login_time") @db.Timestamptz
  logoutTime DateTime? @map("logout_time") @db.Timestamptz
  isActive   Boolean   @default(true) @map("is_active")

  //////////////////////////////////////////////////
  // RELATIONS
  //////////////////////////////////////////////////

  posTerminalId String          @map("pos_terminal_id") @db.Uuid
  posTerminal   PosTerminalInfo @relation(fields: [posTerminalId], references: [id])

  profileId String  @map("profile_id") @db.Uuid
  profile   Profile @relation(fields: [profileId], references: [id])

  @@index([posTerminalId])
  @@index([profileId])
  @@map("pos_session")
  @@schema("public")
}

/////////////////////////////////////////////////
// APPROVAL LOG
/////////////////////////////////////////////////

model ApprovalLog {
  id String @id @default(dbgenerated("gen_random_uuid()")) @map("uuid_approval_log") @db.Uuid

  actionType  String @map("action_type") // e.g. VOID_ITEM, CANCEL_INVOICE
  referenceId String @map("reference_id") @db.Uuid // the id of the voided item/invoice

  //////////////////////////////////////////////////
  // RELATIONS
  //////////////////////////////////////////////////

  managerId String  @map("manager_id") @db.Uuid
  manager   Profile @relation(fields: [managerId], references: [id])

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([managerId])
  @@map("approval_log")
  @@schema("public")
}

/////////////////////////////////////////////////
// AUDIT LOG
/////////////////////////////////////////////////

model AuditLog {
  id String @id @default(dbgenerated("gen_random_uuid()")) @map("uuid_audit_log") @db.Uuid

  companyId String  @map("company_id") @db.Uuid
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  actorProfileId String  @map("actor_profile_id") @db.Uuid
  actorProfile   Profile @relation("ActorAuditLog", fields: [actorProfileId], references: [id])

  posTerminalId String?          @map("pos_terminal_id") @db.Uuid
  posTerminal   PosTerminalInfo? @relation(fields: [posTerminalId], references: [id], onDelete: SetNull)

  actionType  String   @map("action_type")
  referenceId String?  @map("reference_id") @db.Uuid
  changes     String?
  amount      Decimal? @db.Decimal(15, 2)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([companyId])
  @@index([companyId, createdAt])
  @@index([actorProfileId])
  @@index([posTerminalId])
  @@index([posTerminalId, createdAt])
  @@index([actionType, createdAt])
  @@index([createdAt])
  @@map("audit_log")
  @@schema("public")
}

/////////////////////////////////////////////////
// PERMISSIONS
/////////////////////////////////////////////////

model Permission {
  key         PermissionKey @id
  group      String
  label      String
  description String?
  isSensitive Boolean @default(false) @map("is_sensitive")

  rolePermissions RolePermission[]
  userOverrides   UserPermissionOverride[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("permission")
  @@schema("public")
}

model RolePermission {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  companyId String?  @map("company_id") @db.Uuid
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  role UserRole
  permissionKey PermissionKey @map("permission_key")
  permission    Permission    @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  effect PermissionEffect @default(allow)

  createdById String?  @map("created_by_id") @db.Uuid
  createdBy   Profile? @relation("CreatedRolePermissions", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([companyId, role, permissionKey])
  @@index([role, permissionKey])
  @@index([companyId])
  @@map("role_permission")
  @@schema("public")
}

model UserPermissionOverride {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  profileId String  @map("profile_id") @db.Uuid
  profile   Profile @relation("UserPermissionOverrideTarget", fields: [profileId], references: [id], onDelete: Cascade)

  companyId String?  @map("company_id") @db.Uuid
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  permissionKey PermissionKey @map("permission_key")
  permission    Permission    @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  effect PermissionEffect
  reason String?

  createdById String?  @map("created_by_id") @db.Uuid
  createdBy   Profile? @relation("CreatedUserPermissionOverrides", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([profileId, companyId, permissionKey])
  @@index([profileId])
  @@index([companyId])
  @@map("user_permission_override")
  @@schema("public")
}

/////////////////////////////////////////////////
// OPERATIONAL APPROVALS
/////////////////////////////////////////////////

model ApprovalRequest {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  referenceNumber String @unique @map("reference_number")
  companyId       String @map("company_id") @db.Uuid
  company         Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  terminalId String?          @map("terminal_id") @db.Uuid
  terminal   PosTerminalInfo? @relation(fields: [terminalId], references: [id], onDelete: SetNull)

  requestedById String  @map("requested_by_id") @db.Uuid
  requestedBy   Profile @relation("RequestedApprovalRequests", fields: [requestedById], references: [id])

  actionType String @map("action_type")
  targetType String @map("target_type")
  targetId   String? @map("target_id")
  title      String
  summary    String
  beforeSnapshot Json? @map("before_snapshot")
  afterSnapshot  Json? @map("after_snapshot")
  idempotencyKey String? @unique @map("idempotency_key")

  status     ApprovalRequestStatus @default(pending)
  expiresAt  DateTime? @map("expires_at") @db.Timestamptz
  executedAt DateTime? @map("executed_at") @db.Timestamptz

  decisions ApprovalDecision[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@index([companyId, status, createdAt])
  @@index([terminalId])
  @@index([requestedById])
  @@index([targetType, targetId])
  @@map("approval_request")
  @@schema("public")
}

model ApprovalDecision {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  approvalRequestId String          @map("approval_request_id") @db.Uuid
  approvalRequest   ApprovalRequest @relation(fields: [approvalRequestId], references: [id], onDelete: Cascade)

  decidedById String  @map("decided_by_id") @db.Uuid
  decidedBy   Profile @relation("DecidedApprovalRequests", fields: [decidedById], references: [id])

  decision ApprovalDecisionStatus
  note     String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([approvalRequestId])
  @@index([decidedById])
  @@map("approval_decision")
  @@schema("public")
}

/////////////////////////////////////////////////
// TIMESTAMP (POS ACTIVITY LOG)
/////////////////////////////////////////////////

model Timestamp {
  id String @id @default(dbgenerated("gen_random_uuid()")) @map("uuid_timestamp") @db.Uuid

  timestampIn  DateTime? @map("timestamp_in") @db.Timestamptz
  timestampOut DateTime? @map("timestamp_out") @db.Timestamptz

  cashInDrawerAmount    Decimal @default(0) @map("cash_in_drawer_amount") @db.Decimal(15, 2)
  cashOutDrawerAmount   Decimal @default(0) @map("cash_out_drawer_amount") @db.Decimal(15, 2)
  withdrawnDrawerAmount Decimal @default(0) @map("withdrawn_drawer_amount") @db.Decimal(15, 2)
  withdrawnDrawerCount  Decimal @default(0) @map("withdrawn_drawer_count") @db.Decimal(10, 2)

  //////////////////////////////////////////////////
  // RELATIONS
  //////////////////////////////////////////////////

  posTerminalId String          @map("pos_terminal_id") @db.Uuid
  posTerminal   PosTerminalInfo @relation(fields: [posTerminalId], references: [id])

  branchId String? @map("branch_id") @db.Uuid
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  cashierId String  @map("cashier_id") @db.Uuid
  cashier   Profile @relation("CashierTimestamp", fields: [cashierId], references: [id])

  managerInId String?  @map("manager_in_id") @db.Uuid
  managerIn   Profile? @relation("ManagerInTimestamp", fields: [managerInId], references: [id])

  managerOutId String?  @map("manager_out_id") @db.Uuid
  managerOut   Profile? @relation("ManagerOutTimestamp", fields: [managerOutId], references: [id])

  forceClosedById String?  @map("force_closed_by_id") @db.Uuid
  forceClosedBy   Profile? @relation("ForceClosedByTimestamp", fields: [forceClosedById], references: [id])

  deviceId         String?               @map("device_id")
  lastSeenAt       DateTime?             @map("last_seen_at") @db.Timestamptz
  forceClosedAt    DateTime?             @map("force_closed_at") @db.Timestamptz
  forceCloseReason String?               @map("force_close_reason")
  debtPayments     CustomerDebtPayment[]

  //////////////////////////////////////////////////
  // AUDIT
  //////////////////////////////////////////////////

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([posTerminalId])
  @@index([branchId])
  @@index([posTerminalId, timestampIn])
  @@index([cashierId])
  @@index([cashierId, timestampIn])
  @@index([timestampOut])
  @@index([deviceId])
  @@map("timestamp")
  @@schema("public")
}

