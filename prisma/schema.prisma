  OUT
  ADJUSTMENT

  @@map("inventory_transaction_type")
  @@schema("public")
}

/////////////////////////////////////////////////
// CATEGORY
/////////////////////////////////////////////////

model Category {
  id String @id @default(dbgenerated("gen_random_uuid()")) @map("uuid_category") @db.Uuid

  categoryName String? @map("category_name")

  //////////////////////////////////////////////////
  // RELATIONS
  //////////////////////////////////////////////////

  companyId String?  @map("uuid_company") @db.Uuid
  company   Company? @relation(fields: [companyId], references: [id])

  products Product[]

  //////////////////////////////////////////////////
  // AUDIT
  //////////////////////////////////////////////////

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  @@index([companyId])
  @@map("category")
  @@schema("public")
}

/////////////////////////////////////////////////
// PRODUCT
/////////////////////////////////////////////////

model Product {
  id String @id @default(dbgenerated("gen_random_uuid()")) @map("uuid_product") @db.Uuid

  name              String
  productImageUrl   String?       @map("product_image_url") @db.VarChar(500)
  barcode           String?       @db.VarChar(100)
  genericName       String?       @map("generic_name")
  brandName         String?       @map("brand_name")
  shelfLocation     String?       @map("shelf_location")
  prescriptionRequired Boolean    @default(false) @map("prescription_required")
  posFavorite       Boolean       @default(false) @map("pos_favorite")
  reorderPoint      Decimal?      @map("reorder_point") @db.Decimal(19, 4)
  baseUnit          String        @default("") @map("base_unit") @db.VarChar(50)
  quantity          Decimal?      @db.Decimal(19, 4)
  cost              Decimal       @default(0) @db.Decimal(19, 4)
  price             Decimal       @db.Decimal(19, 4)
  isAvailable       Boolean       @default(true) @map("is_available")
  trackInventory    Boolean       @default(false) @map("track_inventory")
  itemType          ItemType      @default(RESALE) @map("item_type")
  vatType           VatType       @default(VATABLE) @map("vat_type")
  isConfigurable    Boolean       @default(false) @map("is_configurable")
  configurationMode BusinessMode? @map("configuration_mode")

  //////////////////////////////////////////////////
  // RELATIONS
  //////////////////////////////////////////////////

  categoryId String   @map("uuid_category") @db.Uuid
  category   Category @relation(fields: [categoryId], references: [id])

  companyId String?  @map("uuid_company") @db.Uuid
  company   Company? @relation(fields: [companyId], references: [id])

  preferredSupplierId String?   @map("preferred_supplier_id") @db.Uuid
  preferredSupplier   Supplier? @relation("ProductPreferredSupplier", fields: [preferredSupplierId], references: [id], onDelete: SetNull)

  images         ProductImage[]
  inventory      Inventory[]
  modifierGroups ProductModifierGroup[]
  returnItems    InvoiceReturnItem[]

  //////////////////////////////////////////////////
  // AUDIT
  //////////////////////////////////////////////////

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz
  items     Item[]
  stockMovements StockMovement[]
  stockLots StockLot[]
  stockCountItems StockCountItem[]
  purchaseOrderItems PurchaseOrderItem[]
  receivingItems ReceivingItem[]
  branchTransferItems BranchTransferItem[]
  promotionRedemptions PromotionRedemptionLog[]

  @@unique([name, categoryId], name: "uk_product_name_category")
  @@unique([companyId, barcode], name: "uk_product_company_barcode")
  @@index([categoryId])
  @@index([companyId])
  @@index([companyId, posFavorite])
  @@index([preferredSupplierId])
  @@index([companyId, genericName])
  @@index([companyId, brandName])
  @@map("product")
  @@schema("public")
}

model ModifierGroup {
  id String @id @default(dbgenerated("gen_random_uuid()")) @map("uuid_modifier_group") @db.Uuid

  companyId String  @map("company_id") @db.Uuid
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name         String
  type         ModifierGroupType
  required     Boolean           @default(false)
  minSelect    Int               @default(0) @map("min_select")
  maxSelect    Int               @default(1) @map("max_select")
  displayOrder Int               @default(0) @map("display_order")
  isActive     Boolean           @default(true) @map("is_active")

  options  ModifierOption[]
  products ProductModifierGroup[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@index([companyId, isActive])
  @@map("modifier_group")
  @@schema("public")
}

model ModifierOption {
  id String @id @default(dbgenerated("gen_random_uuid()")) @map("uuid_modifier_option") @db.Uuid

  modifierGroupId String        @map("modifier_group_id") @db.Uuid
  modifierGroup   ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)

  name         String
  priceDelta   Decimal @default(0) @map("price_delta") @db.Decimal(15, 2)
  displayOrder Int     @default(0) @map("display_order")
  isDefault    Boolean @default(false) @map("is_default")
  isActive     Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@index([modifierGroupId, isActive])
  @@map("modifier_option")
  @@schema("public")
}

model ProductModifierGroup {
  id String @id @default(dbgenerated("gen_random_uuid()")) @map("uuid_product_modifier_group") @db.Uuid

  productId String  @map("product_id") @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  modifierGroupId String        @map("modifier_group_id") @db.Uuid
  modifierGroup   ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)

  displayOrder Int @default(0) @map("display_order")

  @@unique([productId, modifierGroupId], name: "uk_product_modifier_group")
  @@index([productId])
  @@index([modifierGroupId])
  @@map("product_modifier_group")
  @@schema("public")
}

/////////////////////////////////////////////////
// PRODUCT IMAGES
/////////////////////////////////////////////////

model ProductImage {
  id       Int    @id @default(autoincrement())
  imageUrl String @map("image_url")

  productId String  @map("uuid_product") @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
  @@schema("public")
}

/////////////////////////////////////////////////
// INVENTORY
/////////////////////////////////////////////////

model Inventory {
  id String @id @default(dbgenerated("gen_random_uuid()")) @map("uuid_inventory") @db.Uuid

  quantity  Decimal                  @db.Decimal(19, 4)
  type      InventoryTransactionType
  reference String?

  //////////////////////////////////////////////////
  // RELATIONS
  //////////////////////////////////////////////////

  productId String  @map("uuid_product") @db.Uuid
  product   Product @relation(fields: [productId], references: [id])

  //////////////////////////////////////////////////
  // AUDIT
  //////////////////////////////////////////////////

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@index([productId])
  @@index([productId, createdAt])
  @@map("inventory")
  @@schema("public")
}

/////////////////////////////////////////////////
// ENUMS For INVOICE
